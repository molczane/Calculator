file(MAKE_DIRECTORY "${TEST_DIRECTORY}")

function(check_file name input expected expected_status)
    set(input_path "${TEST_DIRECTORY}/${name}-input.txt")
    set(output_path "${TEST_DIRECTORY}/${name}-output.txt")
    file(WRITE "${input_path}" "${input}")
    file(WRITE "${output_path}" "Old output must be replaced, including this trailing text.\n")
    execute_process(COMMAND "${CALCULATOR}" "${input_path}" "${output_path}"
                    RESULT_VARIABLE status ERROR_VARIABLE errors)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${name}: exit=${status}, expected=${expected_status}: ${errors}")
    endif()
    file(READ "${output_path}" actual)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: output does not match expected results")
    endif()
endfunction()

check_file(basic "99 + 1\n1000 - 1\n-12 * 8\n7 / 2\n" "100\n999\n-96\n3\n" 0)
check_file(crlf "\r\n\t \r\n +0012 + -2\r\n1--2" "10\n3\n" 0)
check_file(errors "1 / 0\n1 + 2 + 3\n5 * 6\n1 / -000\n"
           "ERROR: division by zero\nERROR: invalid expression\n30\nERROR: division by zero\n" 1)
check_file(empty "" "" 0)
check_file(blank "\n  \t\n\r\n" "" 0)
string(REPEAT "9" 10000 nines)
string(REPEAT "0" 10000 zeroes)
check_file(long "${nines} + 1\n1${zeroes} - 1" "1${zeroes}\n${nines}\n" 0)

set(alias_input "${TEST_DIRECTORY}/alias-input.txt")
set(original "999 + 1\n")
file(WRITE "${alias_input}" "${original}")
foreach(output_path IN ITEMS "${alias_input}" "${TEST_DIRECTORY}/./alias-input.txt")
    execute_process(COMMAND "${CALCULATOR}" "${alias_input}" "${output_path}"
                    RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${alias_input}" actual)
    if(NOT "${status}" STREQUAL "1" OR NOT "${actual}" STREQUAL "${original}")
        message(FATAL_ERROR "Input/output alias was not safely rejected: ${errors}")
    endif()
endforeach()

foreach(kind IN ITEMS symbolic hard)
    set(link_path "${TEST_DIRECTORY}/${kind}-link.txt")
    file(REMOVE "${link_path}")
    if(kind STREQUAL "symbolic")
        file(CREATE_LINK "${alias_input}" "${link_path}" SYMBOLIC RESULT link_status)
    else()
        file(CREATE_LINK "${alias_input}" "${link_path}" RESULT link_status)
    endif()
    if(NOT "${link_status}" STREQUAL "0")
        message(FATAL_ERROR "Cannot create ${kind} link for test: ${link_status}")
    endif()
    execute_process(COMMAND "${CALCULATOR}" "${alias_input}" "${link_path}"
                    RESULT_VARIABLE status ERROR_VARIABLE errors)
    file(READ "${alias_input}" actual)
    if(NOT "${status}" STREQUAL "1" OR NOT "${actual}" STREQUAL "${original}")
        message(FATAL_ERROR "${kind} input/output alias was not safely rejected: ${errors}")
    endif()
endforeach()

execute_process(COMMAND "${CALCULATOR}" "${TEST_DIRECTORY}/missing.txt"
                "${TEST_DIRECTORY}/unused.txt" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT "${status}" STREQUAL "1" OR EXISTS "${TEST_DIRECTORY}/unused.txt")
    message(FATAL_ERROR "Missing input file was not rejected before creating output: ${errors}")
endif()
execute_process(COMMAND "${CALCULATOR}" "${alias_input}"
                "${TEST_DIRECTORY}/missing-directory/output.txt"
                RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT "${status}" STREQUAL "1")
    message(FATAL_ERROR "Unwritable output path was not rejected: ${errors}")
endif()
execute_process(COMMAND "${CALCULATOR}" RESULT_VARIABLE status ERROR_VARIABLE errors)
if(NOT "${status}" STREQUAL "2")
    message(FATAL_ERROR "Missing arguments did not produce a usage error: ${errors}")
endif()
